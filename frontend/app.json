{
  "expo": {
    "name": "Breeze Technician App",
    "slug": "breeze-technician-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "icon": "./assets/icon.png",

    "splash": {
      "backgroundColor": "#EEF3FC",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.breeze.technician",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Breeze needs your location in the background to track your shift while you're on a job, including when the app is not in the foreground.",
        "NSLocationWhenInUseUsageDescription": "Breeze needs your location to confirm you are at the property before starting a shift."
      }
    },

    "android": {
      "package": "com.breeze.technician",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#202934"
      },

      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]

    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Breeze needs your location in the background to track your shift while you're on a job, including when the app is not in the foreground.",
          "locationWhenInUsePermission": "Breeze needs your location to confirm you are at the property before starting a shift.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-ignore-battery-optimizations"
    ],

    "extra": {
      "eas": {
        "projectId": "822752b8-d045-40bb-a93b-15ebbe135da8"
      }
    }
  }
}