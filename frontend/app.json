{
  "expo": {
    "name": "Breeze Technician App",
    "slug": "breeze-technician-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/app_icon.png",
    "splash": {
      "backgroundColor": "#FFFFFF",
      "image": "./assets/app_icon.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.breeze.technician",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Breeze needs your location in the background to track your shift while you're on a job, including when the app is not in the foreground.",
        "NSLocationWhenInUseUsageDescription": "Breeze needs your location to confirm you are at the property before starting a shift.",
        "NSCameraUsageDescription": "Breeze needs camera access to scan inventory part QR codes."
      }
    },
    "android": {
      "package": "com.breeze.technician",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app_icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Breeze needs your location in the background to track your shift while you're on a job, including when the app is not in the foreground.",
          "locationWhenInUsePermission": "Breeze needs your location to confirm you are at the property before starting a shift.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-ignore-battery-optimizations",
      [
        "expo-camera",
        {
          "cameraPermission": "Breeze needs camera access to scan inventory part QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1aad175f-19bb-4202-bcea-0260417c4502"
      }
    },
    "owner": "ajaybreezes-team"
  }
}